{
  "name": "stellar-did-credit",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "toml@<4.2.0": "4.2.0",
      "markdown-it@<14.3.1": "14.3.1",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "axios@<1.20.0": "1.20.0",
      "handlebars@<4.7.10": "4.7.10"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "eslint packages --ext .ts && cargo clippy --workspace -- -D warnings",
    "lint:fix": "eslint packages --ext .ts --fix && cargo clippy --fix --allow-dirty --workspace -- -D warnings",
    "test": "cargo test --workspace && pnpm --filter @stellar-did-credit/sdk --filter @stellar-did-credit/feeder --filter @stellar-did-credit/cli test",
    "build": "pnpm --filter './packages/*' --if-present build && cargo build --workspace",
    "docs": "cargo doc --workspace --no-deps && pnpm --filter './packages/*' --if-present run docs",
    "license-check": "npx license-checker-rseidelsohn --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause\" --summary"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "license-checker-rseidelsohn": "^4.4.1",
    "lefthook": "1.11.13"
  }
}
